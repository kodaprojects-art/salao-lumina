---
import '@fontsource/nunito/latin-400.css';
import '@fontsource/nunito/latin-600.css';
import '@fontsource/dm-serif-display/latin-400.css';
import '@fontsource/caveat/latin-400.css';
import '../styles/tokens.css';
import '../styles/site.css';
import BaseLayout from '../../../../shared/components/BaseLayout.astro';
import Accordion from '../../../../shared/components/Accordion.astro';
import Img from '../../../../shared/components/Img.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Tabs from '../components/Tabs.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import { content, section, image, link, type ImageRef } from '../lib/content';

const announcement = section('announcement');
const header = section('header');
const hero = section('hero');
const demo = section('demo');
const how = section('how-it-works');
const features = section('features');
const deep1 = section('deep-1');
const deep2 = section('deep-2');
const why = section('why-switch');
const tabs = section('audience-tabs');
const overview = section('overview');
const faq = section('faq');
const finalCta = section('final-cta');
const footer = section('footer');

type Feature = { title: string; text: string; image?: ImageRef };
const featureItems = features.items as Feature[];
const featureRows: Feature[][] = [];
for (let i = 0; i < featureItems.length; i += 2) featureRows.push(featureItems.slice(i, i + 2));
const asset = (ref: ImageRef) => image(ref.unsplashQuery);
---

<BaseLayout title={content.seo.title} description={content.seo.description}>
  <aside slot="header" class="announcement" aria-label="Aviso">
    <p class="container announcement__inner">
      <span>{announcement.text}</span>
      <a href={link(announcement.cta).href}>{announcement.cta.label} <span aria-hidden="true">›</span></a>
    </p>
  </aside>
  <SiteHeader slot="header" logo={header.logoText} links={header.links} login={header.login} cta={link(header.cta)} />

  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__inner">
      <a class="pill" href="#novidades">
        <span>{hero.badge}</span>
        <span aria-hidden="true">›</span>
      </a>
      <h1 id="hero-title" class="hero__title">{hero.heading}</h1>
      <p class="hero__lead">[TODO]</p>
      <a class="btn" href={link(hero.cta).href}>{hero.cta.label} <span aria-hidden="true">›</span></a>
      <p class="hero__note">[TODO]</p>
    </div>

    <div class="demo container" id="novidades">
      <div class="demo__glow" aria-hidden="true"></div>
      <p class="demo__label">{demo.label}</p>
      <div class="demo__frame">
        <Img src={asset(demo.image)} alt={demo.image.alt} priority sizes="(min-width: 1232px) 1232px, 100vw" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <header class="section__head">
        <h2 id="how-title" class="h2">{how.heading}</h2>
        <p class="section__sub">[TODO]</p>
      </header>
      <ol class="steps">
        {how.steps.map((step: { title: string; image: ImageRef }) => (
          <li class="card step">
            <div class="step__media">
              <Img src={asset(step.image)} alt={step.image.alt} sizes="(min-width: 810px) 400px, 100vw" />
            </div>
            <h3 class="step__title">{step.title}</h3>
            <p class="step__text">[TODO]</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="servicos" aria-labelledby="features-title">
    <div class="container">
      <header class="section__head">
        <h2 id="features-title" class="h2">[TODO]</h2>
        <p class="section__sub">[TODO]</p>
      </header>
      {featureRows.map((row) => (
        <div class="feature">
          <div class="feature__intro">
            <h3 class="h3">
              {row.map((item, i) => <span class={i ? 'muted' : undefined}>{item.title}.</span>)}
            </h3>
            <p class="feature__text">{row.map((item) => item.text).join(' ')}</p>
          </div>
          <div class="feature__visuals">
            {row.map((item) => (
              <div class="feature__visual card">
                {item.image ? (
                  <Img src={asset(item.image)} alt={item.image.alt} sizes="(min-width: 810px) 600px, 100vw" />
                ) : (
                  <FeatureIcon title={item.title} />
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="deep1-title">
    <div class="container">
      <header class="section__head">
        <h2 id="deep1-title" class="h2">{deep1.heading}</h2>
        <p class="section__sub">[TODO]</p>
      </header>
      <div class="frame card">
        <Img src={asset(deep1.image)} alt={deep1.image.alt} sizes="(min-width: 1232px) 1000px, 100vw" />
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="deep2-title">
    <div class="container">
      <div class="split card">
        <div class="split__text">
          <h2 id="deep2-title" class="h3">{deep2.heading}</h2>
          <p>[TODO]</p>
        </div>
        <div class="split__media">
          <Img src={asset(deep2.image)} alt={deep2.image.alt} sizes="(min-width: 810px) 600px, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="audience" aria-labelledby="why-title">
    <div class="container">
      <header class="section__head">
        <h2 id="why-title" class="h2">{why.heading}</h2>
        <p class="section__sub">[TODO]</p>
      </header>
      <Tabs tabs={tabs.tabs} points={why.items} />
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="overview-title">
    <div class="container">
      <div class="overview card">
        <span class="overview__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="14" rx="3"></rect><path d="M8 21h8M12 18v3"></path></svg>
        </span>
        <h2 id="overview-title" class="h2">{overview.heading}</h2>
        <p class="section__sub">[TODO]</p>
        <a class="btn" href={link(finalCta.cta).href}>{finalCta.cta.label} <span aria-hidden="true">›</span></a>
        <div class="overview__media">
          <Img src={asset(overview.image)} alt={overview.image.alt} sizes="(min-width: 1232px) 1000px, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container">
      <header class="section__head">
        <h2 id="faq-title" class="h2">{faq.heading}</h2>
        <p class="section__sub">[TODO]</p>
      </header>
      <div class="faq">
        <Accordion items={faq.items.map((i: { q: string; a: string }) => ({ question: i.q, answer: i.a }))} />
      </div>
    </div>
  </section>

  <section class="section final" id="cta" aria-labelledby="final-title">
    <div class="container final__inner">
      <h2 id="final-title" class="h2">{finalCta.heading}</h2>
      <p class="final__sub">[TODO]</p>
      <a class="btn" href={link(finalCta.cta).href}>{finalCta.cta.label} <span aria-hidden="true">›</span></a>
    </div>
  </section>

  <SiteFooter slot="footer" logo={header.logoText} links={footer.links} brand={content.businessName} />
</BaseLayout>
