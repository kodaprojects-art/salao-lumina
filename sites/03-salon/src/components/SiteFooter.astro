---
import { footerAnchors } from '../lib/content';

interface Props {
  logo: string;
  links: string[];
  brand: string;
}

const { logo, links, brand } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__logo" href="/">{logo}</a>
    <nav aria-label="Rodapé">
      <ul class="site-footer__links">
        {links.map((label, i) => <li><a href={footerAnchors[i] ?? '#'}>{label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container site-footer__legal">
    <p>© {year} {brand}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-2xl) var(--space-xl);
    background: var(--color-blue-lighter);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--space-xl);
  }

  .site-footer__logo {
    font-family: var(--font-heading);
    font-size: var(--text-card);
    text-decoration: none;
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--color-slate);
  }

  .site-footer__legal {
    margin-block-start: var(--space-2xl);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  @media (min-width: 810px) {
    .site-footer__inner {
      grid-template-columns: 1fr 3fr;
    }

    .site-footer__links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
