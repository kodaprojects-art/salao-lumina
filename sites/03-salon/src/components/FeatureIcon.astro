---
/** Simple SVG illustration for feature cards without a photo. */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="feature-icon">
  <svg aria-hidden="true" viewBox="0 0 64 64" width="64" height="64" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <rect x="8" y="12" width="48" height="40" rx="6"></rect>
    <path d="M8 22h48M18 32h14M18 40h22M42 32h4"></path>
  </svg>
  <span>{title}</span>
</div>

<style>
  .feature-icon {
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--space-md);
    min-block-size: 280px;
    background: linear-gradient(160deg, var(--color-blue-lighter), var(--color-blue-light));
    color: var(--color-blue);
    font-weight: var(--weight-semibold);
  }

  .feature-icon span {
    color: var(--color-text);
  }
</style>
