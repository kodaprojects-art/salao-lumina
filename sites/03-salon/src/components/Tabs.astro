---
interface Props {
  tabs: { label: string; text: string }[];
  points: string[];
}

const { tabs, points } = Astro.props;
---

<div class="tabs" data-tabs>
  <div class="tabs__list" role="tablist" aria-label="Para quem é">
    {tabs.map((tab, i) => (
      <button
        class="tabs__tab"
        type="button"
        role="tab"
        id={`tab-${i}`}
        aria-controls={`panel-${i}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        {tab.label}
      </button>
    ))}
  </div>
  {tabs.map((tab, i) => (
    <div class="tabs__panel card" role="tabpanel" id={`panel-${i}`} aria-labelledby={`tab-${i}`} tabindex="0" hidden={i !== 0}>
      <h3 class="h3">{tab.label}</h3>
      <p>{tab.text}</p>
      <ul class="tabs__points">
        {points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !active;
      });
      tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') select((i + 1) % tabs.length);
        if (e.key === 'ArrowLeft') select((i - 1 + tabs.length) % tabs.length);
        if (e.key === 'Home') select(0);
        if (e.key === 'End') select(tabs.length - 1);
      });
    });
  });
</script>

<style>
  .tabs__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-block-end: var(--space-xl);
  }

  .tabs__tab {
    padding: var(--space-xs) var(--space-md);
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-button);
    background: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    cursor: pointer;
  }

  .tabs__tab[aria-selected='true'] {
    border-color: var(--color-blue);
    background: var(--color-blue-light);
    color: var(--color-blue-dark);
  }

  .tabs__panel {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl);
    color: var(--color-muted);
  }

  .tabs__panel[hidden] {
    display: none;
  }

  .tabs__panel :global(.h3) {
    color: var(--color-text);
  }

  .tabs__points {
    display: grid;
    gap: var(--space-sm);
    padding-inline-start: var(--space-lg);
  }
</style>
