---
import Button from './Button.astro';

export interface FormField {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
}

interface Props {
  action: string;
  fields: FormField[];
  submitLabel: string;
  method?: 'get' | 'post';
}

const { action, fields, submitLabel, method = 'post' } = Astro.props;
---

<form class="form" action={action} method={method}>
  {fields.map(({ name, label, type = 'text', required = false }) => (
    <div class="form__field">
      <label for={`field-${name}`}>{label}</label>
      {type === 'textarea' ? (
        <textarea id={`field-${name}`} name={name} required={required} rows="4"></textarea>
      ) : (
        <input id={`field-${name}`} name={name} type={type} required={required} />
      )}
    </div>
  ))}
  <div>
    <Button type="submit">{submitLabel}</Button>
  </div>
</form>

<style>
  .form {
    display: grid;
    gap: var(--space-md);
  }

  .form__field {
    display: grid;
    gap: var(--space-xs);
  }

  .form input,
  .form textarea {
    padding: var(--space-sm);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-input);
    background: var(--color-bg);
  }
</style>
