---
import type { NavLink } from './Header.astro';

interface Props {
  brand: string;
  links?: NavLink[];
  legal: string;
}

const { brand, links = [], legal } = Astro.props;
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand">{brand}</p>
    {links.length > 0 && (
      <nav aria-label="Rodapé">
        <ul class="footer__list">
          {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </nav>
    )}
    <slot />
    <p class="footer__legal">{legal}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-xl);
    background: var(--color-surface);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-md);
  }

  .footer__brand {
    font-family: var(--font-heading);
  }

  .footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding: 0;
    list-style: none;
  }

  .footer__legal {
    font-size: var(--text-sm);
  }
</style>
