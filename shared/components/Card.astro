---
interface Props {
  title: string;
  href?: string;
  headingLevel?: 'h2' | 'h3' | 'h4';
}

const { title, href, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="card">
  <slot name="media" />
  <div class="card__body">
    <Heading class="card__title">{href ? <a href={href}>{title}</a> : title}</Heading>
    <slot />
  </div>
</article>

<style>
  .card {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .card__body {
    display: grid;
    gap: var(--space-sm);
    padding: var(--space-md);
  }

  .card__title a {
    text-decoration: none;
  }
</style>
